APP_NAME=The Natural Path Spa
APP_ENV=development
DEBUG=true
DEPLOYMENT_TARGET=local
USE_DOCKER_NETWORK=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,https://frontend.naturepath-local.orb.local,http://frontend.naturepath-local.orb.local

MONGO_URL=
MONGO_HOST_LOCAL=127.0.0.1
MONGO_HOST_DOCKER=mongodb
MONGO_PORT=27017
DB_NAME=natural_path_spa

REDIS_URL=
REDIS_HOST_LOCAL=127.0.0.1
REDIS_HOST_DOCKER=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=change-me-in-local-and-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Installed PWA (X-Client-Mode: standalone) uses a longer refresh TTL
REFRESH_TOKEN_EXPIRE_DAYS_STANDALONE=90

# --- Google OAuth (Firebase Web client ID) ---
# See docs/GOOGLE_OAUTH_FIREBASE_SETUP.md
# 1) Firebase Console → Authentication → Sign-in method → enable Google
# 2) Copy Web client ID (…apps.googleusercontent.com)
# 3) Add authorized domains: localhost + production host
GOOGLE_OAUTH_CLIENT_ID=
# Optional — only needed for auth-code / token exchange flows
GOOGLE_OAUTH_CLIENT_SECRET=

S3_BUCKET_NAME=natural-path-spa
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

REVEL_API_URL=https://api.revelup.com
REVEL_API_KEY=
REVEL_API_SECRET=
REVEL_ESTABLISHMENT_ID=1
# Merchant subdomain (with or without .revelup.com), e.g. thenaturalpathla
REVEL_SUBDOMAIN=
# Optional: full REST root for sandbox, e.g. https://api-sandbox-revel.revelup.com
REVEL_REST_BASE_URL=
REVEL_HTTP_TIMEOUT_SECONDS=20
REVEL_ENABLE_HOSTED_PAYMENTS=false
REVEL_ENABLE_HOLD_ORDERS=false
# Dev-only: accept webhooks without HMAC verification. DO NOT enable in any shared env.
ALLOW_UNSIGNED_WEBHOOKS=false
REFUND_SLA_BUSINESS_DAYS=3
# G2 — retry uncertain card refunds (reconciliation_pending); see workers/refund_reconciliation_worker.py
REFUND_RECONCILIATION_SWEEP_MIN_AGE_MINUTES=15
REFUND_RECONCILIATION_SWEEP_MAX_BATCH=50
REFUND_RECONCILIATION_SWEEP_MAX_ATTEMPTS=48
DEFAULT_CURRENCY=USD
STORE_TAX_RATE=0.0925
OPS_EMAIL=
REVEL_HOSTED_PAYMENT_ENDPOINT=HostedPaymentLink

# Public web app URL (used in emails / links when needed)
PUBLIC_APP_URL=http://localhost:5173

# Prefer Hostinger SMTP in prod/local. Leave RESEND_API_KEY empty (Resend wins when set).
RESEND_API_KEY=
SENDER_EMAIL=support@YOUR_DOMAIN
# Hostinger SMTP: host smtp.hostinger.com, port 465 (implicit SSL).
# Port 587 + SMTP_USE_TLS=true also works (STARTTLS). Never commit real passwords.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USERNAME=support@YOUR_DOMAIN
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_SENDER_EMAIL=support@YOUR_DOMAIN

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

APP_NAME=The Natural Path Spa
APP_ENV=development
DEBUG=true
DEPLOYMENT_TARGET=local
USE_DOCKER_NETWORK=false
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGO_URL=
MONGO_HOST_LOCAL=127.0.0.1
MONGO_HOST_DOCKER=mongodb
MONGO_PORT=27017
DB_NAME=natural_path_spa

REDIS_URL=
REDIS_HOST_LOCAL=127.0.0.1
REDIS_HOST_DOCKER=redis
REDIS_PORT=6379
REDIS_DB=0

JWT_SECRET_KEY=change-me-in-local-and-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

S3_BUCKET_NAME=natural-path-spa
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_ENDPOINT_URL=

REVEL_API_URL=https://api.revelup.com
REVEL_API_KEY=
REVEL_API_SECRET=
REVEL_ESTABLISHMENT_ID=1

# Booking: pay_at_counter (default, no online card) | revel_online (REVEL POS charge on confirm)
BOOKING_CHECKOUT_MODE=pay_at_counter
# Public web app URL (used in emails / links when needed)
PUBLIC_APP_URL=http://localhost:5173

RESEND_API_KEY=
SENDER_EMAIL=onboarding@resend.dev
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=
SMTP_SENDER_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
